# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://cardvalue:cardvalue@localhost:5432/cardvalue
STORAGE_DIR=./data/storage
# Required in production (>= 32 random characters)
SESSION_SECRET=

# Identification model (server-side only). Model and reasoning effort are separate settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=high
OPENAI_MAX_OUTPUT_TOKENS=16000
OPENAI_TIMEOUT_MS=180000
# Optional: USD per million tokens, for per-analysis cost estimates. Blank = report tokens only.
OPENAI_PRICE_INPUT_PER_MTOK=
OPENAI_PRICE_OUTPUT_PER_MTOK=

# PSA certificate verification (token from PSA). Blank = disabled.
PSA_API_TOKEN=
PSA_API_BASE_URL=https://api.psacard.com/publicapi

# Historical FX for foreign-currency sales: none | frankfurter (ECB reference rates)
FX_PROVIDER=none

# Synthetic FIXTURE sales for local demos. Ignored when NODE_ENV=production.
ALLOW_FIXTURES=false

# Run the job worker inside the web process (default true outside production).
WORKER_IN_PROCESS=true
MAX_UPLOAD_BYTES=26214400
